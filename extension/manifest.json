{
  "manifest_version": 3,
  "name": "Javis",
  "version": "0.8.1",
  "description": "Javis, seu mordomo de IA local: resumos, YouTube, Discord, tradução, live, prints analisáveis e preenchimento supervisionado de formulários.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "activeTab", "scripting", "tabCapture"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir Javis",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["content/translator.js"],
      "run_at": "document_idle"
    }
  ]
}
